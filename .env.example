# Copy to .env and edit. `make serve` and `make demo-db` export these; nothing reads .env otherwise.
# Never commit .env.

# Bind address and port for `agentaudit serve`.
AGENTAUDIT_HOST=127.0.0.1
AGENTAUDIT_PORT=8000

# Where the demo deployment lives: the audit database, the witness (anchor) file and the
# signing key. AGENTAUDIT_DB and AGENTAUDIT_WITNESS override the defaults inside AGENTAUDIT_VAR.
AGENTAUDIT_VAR=var
AGENTAUDIT_DB=
AGENTAUDIT_WITNESS=

# HMAC key for signed checkpoints, as 64 hex characters (32 bytes). Leave empty to have
# `agentaudit demo-db` create var/signing.key with file mode 0600.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AGENTAUDIT_SIGNING_KEY=

# Optional bearer token for every /api route except /api/health, for headless API use.
# The console does not send it, so leave it empty when serving the console on localhost.
AGENTAUDIT_API_TOKEN=

# Read requests per second per client. Replays and tamper-lab runs are fixed at 1/s, burst 10.
AGENTAUDIT_RATE_PER_SEC=50
